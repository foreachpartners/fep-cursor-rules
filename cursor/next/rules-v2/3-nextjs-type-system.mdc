# Next.js Type System Guidelines

## 1. TypeScript Configuration (P0)

1. CRITICAL: Required tsconfig.json settings:
   ```json
   {
     "compilerOptions": {
       "target": "es2017",
       "lib": ["dom", "dom.iterable", "esnext"],
       "allowJs": true,
       "skipLibCheck": true,
       "strict": true,
       "forceConsistentCasingInFileNames": true,
       "noEmit": true,
       "esModuleInterop": true,
       "module": "esnext",
       "moduleResolution": "bundler",
       "resolveJsonModule": true,
       "isolatedModules": true,
       "jsx": "preserve",
       "incremental": true,
       "plugins": [
         {
           "name": "next"
         }
       ],
       "paths": {
         "@/*": ["./*"]
       }
     },
     "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
     "exclude": ["node_modules"]
   }
   ```

2. REQUIRED: Additional strictness options:
   ```json
   {
     "compilerOptions": {
       // ... existing options
       "noImplicitAny": true,
       "strictNullChecks": true,
       "strictFunctionTypes": true,
       "noFallthroughCasesInSwitch": true
     }
   }
   ```

3. ESSENTIAL: Path aliases configuration:
   ```json
   {
     "compilerOptions": {
       "baseUrl": ".",
       "paths": {
         "@/components/*": ["components/*"],
         "@/lib/*": ["lib/*"],
         "@/styles/*": ["styles/*"],
         "@/types/*": ["types/*"],
         "@/app/*": ["app/*"]
       }
     }
   }
   ```

## 2. Type Declarations (P0)

1. CRITICAL: Organization of type files:
   ```
   /types
     /api           # API related types
     /models        # Domain models
     /components    # Component props
     /hooks         # Hook return types
     /context       # Context types
     index.ts       # Re-exports
   ```

2. REQUIRED: Common base types:
   ```tsx
   // types/api/response.ts
   export interface ApiResponse<T> {
     data: T;
     meta?: {
       page?: number;
       limit?: number;
       total?: number;
     };
   }
   
   export interface ApiError {
     code: string;
     message: string;
     details?: Record<string, unknown>;
   }
   
   // types/models/user.ts
   export interface User {
     id: string;
     name: string;
     email: string;
     role: UserRole;
     createdAt: string;
   }
   ```

3. ESSENTIAL: Export and import best practices:
   ```tsx
   // types/index.ts
   export * from './api/response';
   export * from './models/user';
   
   // Component usage
   import { ApiResponse, User } from '@/types';
   ```

## 3. Next.js Specific Types (P0)

1. CRITICAL: Route handlers:
   ```tsx
   // app/api/users/route.ts
   import { NextRequest, NextResponse } from 'next/server';
   import { User } from '@/types';
   
   export async function GET(
     request: NextRequest
   ): Promise<NextResponse<{ users: User[] }>> {
     return NextResponse.json({ users: [] });
   }
   
   export async function POST(
     request: NextRequest
   ): Promise<NextResponse<{ user: User } | { error: string }>> {
     try {
       const data = await request.json();
       return NextResponse.json({ user: newUser });
     } catch (error) {
       return NextResponse.json(
         { error: 'Failed to create user' },
         { status: 400 }
       );
     }
   }
   ```

2. REQUIRED: Page and layout props:
   ```tsx
   // app/[slug]/page.tsx
   export interface PageProps {
     params: { slug: string };
     searchParams: { [key: string]: string | string[] | undefined };
   }
   
   export default function Page({ params, searchParams }: PageProps) {
     // Implementation
   }
   
   // app/[slug]/layout.tsx
   export interface LayoutProps {
     children: React.ReactNode;
     params: { slug: string };
   }
   ```

3. ESSENTIAL: Static generation typing:
   ```tsx
   // app/blog/[slug]/page.tsx
   import { Metadata } from 'next';
   
   interface Post {
     title: string;
     description: string;
     slug: string;
   }
   
   interface Params {
     slug: string;
   }
   
   export async function generateMetadata(
     { params }: { params: Params }
   ): Promise<Metadata> {
     const post = await getPost(params.slug);
     return {
       title: post.title,
       description: post.description,
     };
   }
   
   export async function generateStaticParams(): Promise<Params[]> {
     const posts = await getPosts();
     return posts.map((post) => ({
       slug: post.slug,
     }));
   }
   ```

## 4. Component Typing (P1)

1. CRITICAL: Component prop types:
   ```tsx
   // components/Button/Button.tsx
   import { ButtonHTMLAttributes } from 'react';
   
   export type ButtonVariant = 'primary' | 'secondary' | 'outline' | 'ghost';
   export type ButtonSize = 'sm' | 'md' | 'lg';
   
   export interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
     variant?: ButtonVariant;
     size?: ButtonSize;
     isLoading?: boolean;
     isFullWidth?: boolean;
   }
   
   export function Button({
     variant = 'primary',
     size = 'md',
     isLoading = false,
     isFullWidth = false,
     children,
     className,
     ...props
   }: ButtonProps) {
     // Implementation
   }
   ```

2. REQUIRED: Children prop typing:
   ```tsx
   // components/Card/Card.tsx
   interface CardProps {
     children: React.ReactNode;
     className?: string;
   }
   
   // For specific children types
   interface ListProps {
     children: React.ReactElement<typeof ListItem>[];
   }
   
   // For render props
   interface CollapsibleProps {
     renderTrigger: (isOpen: boolean) => React.ReactNode;
     renderContent: () => React.ReactNode;
   }
   ```

3. ESSENTIAL: Generic components:
   ```tsx
   // components/Select/Select.tsx
   interface SelectProps<T> {
     options: T[];
     value: T | null;
     onChange: (value: T) => void;
     getLabel: (option: T) => string;
     getValue: (option: T) => string;
   }
   
   export function Select<T>({
     options,
     value,
     onChange,
     getLabel,
     getValue,
   }: SelectProps<T>) {
     // Implementation
   }
   
   // Usage
   <Select<User>
     options={users}
     value={selectedUser}
     onChange={setSelectedUser}
     getLabel={(user) => user.name}
     getValue={(user) => user.id}
   />
   ```

## 5. Hook and Context Typing (P1)

1. CRITICAL: Hook return types:
   ```tsx
   // hooks/useUser.ts
   import { User } from '@/types';
   
   interface UseUserResult {
     user: User | null;
     isLoading: boolean;
     error: Error | null;
     refetch: () => Promise<void>;
   }
   
   export function useUser(userId: string): UseUserResult {
     // Implementation
   }
   ```

2. REQUIRED: Context typing:
   ```tsx
   // contexts/AuthContext.tsx
   import { User } from '@/types';
   
   interface AuthContextType {
     user: User | null;
     isLoading: boolean;
     login: (email: string, password: string) => Promise<void>;
     logout: () => Promise<void>;
   }
   
   const AuthContext = createContext<AuthContextType | null>(null);
   
   export function useAuth(): AuthContextType {
     const context = useContext(AuthContext);
     if (!context) {
       throw new Error('useAuth must be used within an AuthProvider');
     }
     return context;
   }
   ```

## 6. Advanced Type Patterns (P1)

1. CRITICAL: Discriminated unions:
   ```tsx
   // types/api/response.ts
   type ApiResult<T> = 
     | { status: 'success'; data: T; meta?: Record<string, unknown> }
     | { status: 'error'; error: ApiError };
   
   // Usage
   function handleResponse(result: ApiResult<User>) {
     if (result.status === 'success') {
       // TypeScript knows result.data exists
       console.log(result.data.name);
     } else {
       // TypeScript knows result.error exists
       console.error(result.error.message);
     }
   }
   ```

2. REQUIRED: Utility types:
   ```tsx
   // types/utils.ts
   export type Nullable<T> = T | null;
   
   export type Optional<T> = T | undefined;
   
   export type AsyncData<T> = {
     data: T | null;
     isLoading: boolean;
     error: Error | null;
   };
   
   export type DeepPartial<T> = T extends object
     ? { [P in keyof T]?: DeepPartial<T[P]> }
     : T;
   ```

3. ESSENTIAL: Type guards:
   ```tsx
   // utils/typeGuards.ts
   import { User, Post, Comment } from '@/types';
   
   export function isUser(obj: any): obj is User {
     return (
       obj &&
       typeof obj === 'object' &&
       'id' in obj &&
       'name' in obj &&
       'email' in obj
     );
   }
   
   // Usage
   function processEntity(entity: unknown) {
     if (isUser(entity)) {
       // TypeScript knows entity is User
       console.log(entity.name);
     }
   }
   ```

## 7. Type-Safe API Calls (P2)

1. CRITICAL: Typed API client:
   ```tsx
   // lib/api.ts
   import { ApiResponse, ApiError, User } from '@/types';
   
   async function fetchApi<T>(
     endpoint: string,
     options?: RequestInit
   ): Promise<ApiResponse<T>> {
     const response = await fetch(`/api/${endpoint}`, options);
     if (!response.ok) {
       const error = await response.json();
       throw new Error(error.message || 'Something went wrong');
     }
     return response.json();
   }
   
   export const api = {
     users: {
       getAll: () => fetchApi<User[]>('users'),
       getById: (id: string) => fetchApi<User>(`users/${id}`),
       create: (data: Omit<User, 'id'>) => 
         fetchApi<User>('users', {
           method: 'POST',
           body: JSON.stringify(data),
         }),
     },
   };
   ```

## 8. Zod Schema Validation (P2)

1. REQUIRED: Type safety with Zod:
   ```tsx
   // schemas/user.ts
   import { z } from 'zod';
   
   export const userSchema = z.object({
     id: z.string().uuid(),
     name: z.string().min(1).max(100),
     email: z.string().email(),
     role: z.enum(['admin', 'user', 'guest']),
     createdAt: z.string().datetime(),
   });
   
   export type User = z.infer<typeof userSchema>;
   
   // Partial schema for updates
   export const userUpdateSchema = userSchema
     .omit({ id: true, createdAt: true })
     .partial();
   
   export type UserUpdate = z.infer<typeof userUpdateSchema>;
   ```

## 9. Error Handling (P2)

1. REQUIRED: Type-safe error handling:
   ```tsx
   // types/errors.ts
   export class AppError extends Error {
     constructor(
       public readonly code: string,
       message: string,
       public readonly statusCode: number = 400
     ) {
       super(message);
       this.name = 'AppError';
     }
   }
   
   // Usage
   try {
     // Some operation
   } catch (error) {
     if (error instanceof AppError) {
       console.error(`${error.code}: ${error.message}`);
     } else {
       console.error('Unknown error:', error);
     }
   }
   ```

## 10. Environment Variables (P2)

1. REQUIRED: Type-safe environment variables:
   ```tsx
   // types/env.d.ts
   declare namespace NodeJS {
     interface ProcessEnv {
       NODE_ENV: 'development' | 'production' | 'test';
       NEXT_PUBLIC_API_URL: string;
       DATABASE_URL: string;
     }
   }
   
   // Usage
   const apiUrl = process.env.NEXT_PUBLIC_API_URL;
   // TypeScript knows apiUrl is a string
   ``` 