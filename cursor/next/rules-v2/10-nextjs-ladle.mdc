# Next.js Ladle Guidelines

## 1. Ladle Setup and Configuration (P0)

1. CRITICAL: Initial installation:
   ```bash
   # Add Ladle to existing Next.js project
   pnpm add @ladle/react react react-dom -D
   
   # Start Ladle development server
   pnpm ladle serve
   
   # Build Ladle for production
   pnpm ladle build
   ```

2. REQUIRED: Vite configuration for Next.js components:
   ```js
   // vite.config.ts
   import path from "path";
   import { defineConfig } from "vite";
   
   export default defineConfig({
     resolve: {
       alias: {
         "next/image": path.resolve(__dirname, "./.ladle/UnoptimizedImage.tsx"),
         "next/link": path.resolve(__dirname, "./.ladle/UnoptimizedLink.tsx"),
       },
     },
   });
   ```

3. ESSENTIAL: Component mocks for Next.js:
   ```tsx
   // .ladle/UnoptimizedImage.tsx
   const UnoptimizedImage = (props: any) => {
     return <img {...props} />;
   };
   export default UnoptimizedImage;
   
   // .ladle/UnoptimizedLink.tsx
   const UnoptimizedLink = (props: any) => {
     return <a {...props} />;
   };
   export default UnoptimizedLink;
   ```

4. REQUIRED: Ladle configuration:
   ```js
   // .ladle/config.mjs
   /** @type {import('@ladle/react').UserConfig} */
   export default {
     stories: 'components/**/*.stories.{js,jsx,ts,tsx}',
     outDir: '.ladle',
     port: 61000,
     addons: {
       a11y: { enabled: true },
       action: { enabled: true },
       controls: { enabled: true },
       ladle: { enabled: true },
       source: { enabled: true },
       width: { enabled: true },
     },
   };
   ```

## 2. Story Organization (P0)

1. CRITICAL: Story location and naming:
   ```
   # Co-located with components (recommended)
   components/
   ├── Button/
   │   ├── Button.tsx
   │   ├── Button.stories.tsx
   │   └── index.ts
   └── Card/
       ├── Card.tsx
       ├── Card.stories.tsx
       └── index.ts
   
   # Centralized in stories directory (alternative)
   stories/
   ├── Button.stories.tsx
   └── Card.stories.tsx
   ```

2. REQUIRED: Story structure:
   ```tsx
   // Button.stories.tsx
   import type { Story } from '@ladle/react';
   import { Button } from './Button';
   
   export default {
     title: 'UI/Button',
   };
   
   interface ButtonStoryProps {
     variant: 'primary' | 'secondary' | 'outline';
     size: 'sm' | 'md' | 'lg';
     children: string;
   }
   
   export const Primary: Story<ButtonStoryProps> = (args) => (
     <Button variant={args.variant} size={args.size}>
       {args.children}
     </Button>
   );
   
   Primary.args = {
     variant: 'primary',
     size: 'md',
     children: 'Button',
   };
   
   Primary.argTypes = {
     variant: {
       control: { type: 'select' },
       options: ['primary', 'secondary', 'outline'],
     },
     size: {
       control: { type: 'radio' },
       options: ['sm', 'md', 'lg'],
     },
   };
   ```

3. ESSENTIAL: Component composition:
   ```tsx
   // CardWithButton.stories.tsx
   import type { Story } from '@ladle/react';
   import { Card } from '../Card/Card';
   import { Button } from '../Button/Button';
   
   export const Default: Story = () => (
     <Card>
       <Card.Header>Card Title</Card.Header>
       <Card.Body>Card content goes here</Card.Body>
       <Card.Footer>
         <Button variant="primary">Action</Button>
       </Card.Footer>
     </Card>
   );
   ```

## 3. Component Documentation (P1)

1. CRITICAL: JSDoc comments:
   ```tsx
   // Button.tsx
   
   /**
    * Button component for user interactions.
    * 
    * @param props - The component props
    * @param props.variant - Visual style of the button
    * @param props.size - Size of the button
    * @param props.disabled - Whether the button is disabled
    */
   export function Button({ variant, size, disabled, children }: ButtonProps) {
     // Implementation
   }
   ```

2. REQUIRED: Markdown documentation:
   ```tsx
   // Button.mdx or Button.stories.mdx
   import { Button } from './Button';
   
   # Button Component
   
   Buttons are used to trigger actions or events.
   
   ## Usage
   
   ```tsx
   import { Button } from '@/components/ui/Button';
   
   export function Form() {
     return (
       <Button variant="primary" size="md">
         Submit
       </Button>
     );
   }
   ```
   
   ## Props
   
   | Name     | Type                                 | Default    | Description                |
   | -------- | ------------------------------------ | ---------- | -------------------------- |
   | variant  | 'primary' \| 'secondary' \| 'outline' | 'primary'  | Visual style of the button |
   | size     | 'sm' \| 'md' \| 'lg'                 | 'md'       | Size of the button         |
   | disabled | boolean                              | false      | Disable the button         |
   ```

## 4. Interaction Testing (P1)

1. CRITICAL: Action logging:
   ```tsx
   // Button.stories.tsx
   import type { Story } from '@ladle/react';
   import { Button } from './Button';
   import { action } from '@ladle/react';
   
   export const WithActions: Story = () => (
     <Button 
       variant="primary" 
       onClick={action('button-clicked')}
     >
       Click Me
     </Button>
   );
   ```

2. REQUIRED: Interactive controls:
   ```tsx
   // Form.stories.tsx
   import type { Story } from '@ladle/react';
   import { useState } from 'react';
   import { Button } from '../Button/Button';
   import { Input } from '../Input/Input';
   
   export const InteractiveForm: Story = () => {
     const [name, setName] = useState('');
     const [email, setEmail] = useState('');
     
     const handleSubmit = (e: React.FormEvent) => {
       e.preventDefault();
       action('form-submitted')({ name, email });
     };
     
     return (
       <form onSubmit={handleSubmit} className="space-y-4">
         <Input
           label="Name"
           value={name}
           onChange={(e) => setName(e.target.value)}
         />
         <Input
           label="Email"
           type="email"
           value={email}
           onChange={(e) => setEmail(e.target.value)}
         />
         <Button type="submit">Submit</Button>
       </form>
     );
   };
   ```

## 5. Accessibility Testing (P2)

1. CRITICAL: A11y addon configuration:
   ```js
   // .ladle/config.mjs
   export default {
     // ... other config
     a11y: {
       // Configure axe-core options
       config: {
         rules: [
           {
             id: 'color-contrast',
             enabled: true,
           },
         ],
       },
     },
   };
   ```

2. REQUIRED: Accessibility testing:
   ```tsx
   // Button.stories.tsx
   
   // Test color contrast for different variants
   export const AccessibilityTest: Story = () => (
     <div className="space-y-4">
       <div className="p-4">
         <Button variant="primary">Primary Button</Button>
       </div>
       <div className="p-4 bg-slate-800">
         <Button variant="outline">Outline on Dark</Button>
       </div>
     </div>
   );
   ```

## 6. Responsive Testing (P2)

1. REQUIRED: Viewport testing:
   ```tsx
   // ResponsiveCard.stories.tsx
   import type { Story } from '@ladle/react';
   import { Card } from '../Card/Card';
   
   export const ResponsiveCard: Story = () => (
     <Card className="w-full max-w-md mx-auto">
       <Card.Header>Responsive Card</Card.Header>
       <Card.Body>
         This card adapts to different viewport sizes.
         Try resizing the viewport to see the changes.
       </Card.Body>
     </Card>
   );
   
   // Use width control in Ladle to test different viewport sizes
   ```

## 7. Theme Testing (P3)

1. RECOMMENDED: Theme provider setup:
   ```tsx
   // .ladle/components.tsx
   import { GlobalProvider } from '@ladle/react';
   import { useState } from 'react';
   import '../src/styles/globals.css'; // Import your global styles
   
   export const Provider: GlobalProvider = ({ children, globalState }) => {
     const [theme, setTheme] = useState(globalState.theme);
     
     return (
       <div className={theme === 'dark' ? 'dark' : ''}>
         <div className="min-h-screen bg-white dark:bg-slate-900 text-black dark:text-white p-4">
           {children}
         </div>
       </div>
     );
   };
   
   // Define global states
   export const globalState = {
     theme: {
       defaultValue: 'light',
       options: ['light', 'dark'],
     },
   };
   ```

## 8. Performance Considerations (P3)

1. RECOMMENDED: Hot reloading optimization:
   ```tsx
   // Use React.memo for complex components
   import { memo } from 'react';
   
   interface DataTableProps {
     // props
   }
   
   const DataTable = memo(function DataTable(props: DataTableProps) {
     // Implementation
     return <div>...</div>;
   });
   
   // Story will benefit from memoization
   export const Default: Story = () => (
     <DataTable data={largeDataset} />
   );
   ```