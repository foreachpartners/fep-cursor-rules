2. RECOMMENDED: Versioning approach:
   ```bash
   # When updating shadcn/ui components, handle carefully to avoid breaking changes
   
   # 1. Back up your existing component
   cp components/ui/button.tsx components/ui/button.tsx.bak
   
   # 2. Generate the new version with the --overwrite flag
   pnpx shadcn-ui@latest add button --overwrite --yes
   
   # 3. Compare and merge custom modifications if needed
   diff components/ui/button.tsx.bak components/ui/button.tsx
   ```

3. ESSENTIAL: Testing approach:
   ```typescript
   // tests/component/button.test.tsx
   import { render, screen } from "@testing-library/react";
   import userEvent from "@testing-library/user-event";
   import { Button } from "@/components/ui/button";
   
   describe("Button component", () => {
     it("renders correctly with default variant", () => {
       render(<Button>Click me</Button>);
       const button = screen.getByRole("button", { name: /click me/i });
       expect(button).toBeInTheDocument();
       expect(button).toHaveClass("bg-primary");
     });
     
     it("handles click events", async () => {
       const handleClick = jest.fn();
       render(<Button onClick={handleClick}>Click me</Button>);
       
       await userEvent.click(screen.getByRole("button", { name: /click me/i }));
       expect(handleClick).toHaveBeenCalledTimes(1);
     });
     
     it("applies different variants correctly", () => {
       const { rerender } = render(<Button variant="secondary">Secondary</Button>);
       expect(screen.getByRole("button")).toHaveClass("bg-secondary");
       
       rerender(<Button variant="outline">Outline</Button>);
       expect(screen.getByRole("button")).toHaveClass("border");
     });
   });
   